{
    "id": "traveller",
    "forks": [
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "bowl_that_shines",
                    "status": "active",
                    "objectiveIndex": 1
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.bowlThatShines.clue.0",
                    "text": "What's up?"
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.bowlThatShines.clue.player.0",
                    "text": "Have you seen a key?"
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.bowlThatShines.clue.1",
                    "text": "Nope. But I heard this: when the sky is dark and the stars glimmer, the moon reveals treasure reflections in the water."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.bowlThatShines.clue.2",
                    "text": "If you're key hunting, check the docks at night."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "village_weirdo",
                    "status": "completed"
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.post.0",
                    "text": "How's the silver treating you? Spend it wisely, not stylishly."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "village_weirdo",
                    "status": "active",
                    "objectiveIndex": 1
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.0",
                    "text": "You actually came back with a yekberry. You're incredibly kind."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.1",
                    "text": "Confession: this was a social experiment. I wanted to see if Anchor Hollow still had generous people."
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.player.0",
                    "text": "Bro is NOT MrBeast."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.2",
                    "text": "Fair. My budget is... less theatrical."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.3",
                    "text": "I can spare one silver coin. It's not much, but it'll be useful."
                },
                {
                    "speaker": "player",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.player.1",
                    "text": "I've never had a coin before..."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.4",
                    "text": "You've never had a coin? What, do you live under a rock?"
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.5",
                    "text": "A silver coin is worth 100 bronze coins."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.6",
                    "text": "And 100 silver coins make one gold coin."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.return.7",
                    "text": "One silver might not look like much, but used properly, it can get you what you need."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "village_weirdo",
                    "status": "active",
                    "objectiveIndex": 0
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.traveller.villageWeirdo.collect.0",
                    "text": "I still need 1 yekberry. Bring one and I'll make it worth your time."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "anti_death_measures",
                    "status": "completed",
                    "negate": true
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.traveller.greeting.0",
                    "text": "Road dust fades. Stories don't."
                }
            ]
        },
        {
