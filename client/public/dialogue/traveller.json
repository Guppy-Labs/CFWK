                    "textKey": "dialogue.npc.traveller.greeting.0",
                    "text": "Road dust fades. Stories don't."
                }
            ]
        }
    ],
    "lines": [
        {
            "speaker": "npc",
            "emotion": "surprise",
            "textKey": "dialogue.npc.traveller.villageWeirdo.intro.0",
            "text": "Traveler's request: could you bring me 1 yekberry?"
        },
        {
            "speaker": "player",
            "emotion": "surprise",
            "textKey": "dialogue.npc.traveller.villageWeirdo.intro.player.0",
            "text": "One? That's oddly specific."
        },
        {
            "speaker": "npc",
            "emotion": "happy",
            "textKey": "dialogue.npc.traveller.villageWeirdo.intro.1",
            "text": "Specific goals build character. Please and thank you."
        }
    ]
