                    "speaker": "player",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.guard.heed.return.player.0",
                    "text": "I'm back!"
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "shake": "mild",
                    "textKey": "dialogue.npc.guard.heed.return.0",
                    "text": "WHAT?? How did you survive that???"
