    "lines": [
        {
            "speaker": "npc",
            "emotion": "angry",
            "textKey": "dialogue.npc.guard.heed.intro.0",
            "text": "WOAH! Where do you think you're going??"
        },
        {
            "speaker": "player",
            "emotion": "surprise",
            "textKey": "dialogue.npc.guard.heed.intro.choice.prompt",
            "text": "How should I answer?",
            "options": [
                {
                    "id": "exploring",
                    "textKey": "dialogue.npc.guard.heed.intro.choice.exploring",
                    "text": "Uhhh... I'm just exploring I guess?",
                    "lines": [
                        {
                            "speaker": "npc",
                            "emotion": "angry",
                            "textKey": "dialogue.npc.guard.heed.intro.1",
                            "text": "Well, what do you think is over there? A fancy hotel? Look kid, you aren't ready for what's across this bridge"
                        },
                        {
                            "speaker": "player",
                            "emotion": "angry",
                            "textKey": "dialogue.npc.guard.heed.intro.player.0",
                            "text": "Yes I am."
                        },
                        {
                            "speaker": "npc",
                            "emotion": "angry",
                            "shake": "mild",
                            "textKey": "dialogue.npc.guard.heed.intro.2",
                            "text": "NO YOU AREN'T!"
                        },
                        {
                            "speaker": "player",
                            "emotion": "angry",
                            "textKey": "dialogue.npc.guard.heed.intro.player.1",
                            "text": "Yes I am."
                        },
                        {
                            "speaker": "npc",
                            "emotion": "happy",
                            "textKey": "dialogue.npc.guard.heed.intro.3",
                            "text": "Okay fine. If you're really so tough, cross this bridge, and stay a while. Let's say... 60 seconds. Sound good?"
                        },
                        {
                            "speaker": "player",
                            "emotion": "happy",
                            "textKey": "dialogue.npc.guard.heed.intro.player.2",
                            "text": "Sure!"
                        },
