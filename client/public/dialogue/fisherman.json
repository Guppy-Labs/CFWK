{
    "id": "fisherman",
    "forks": [
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "first_catch",
                    "status": "active",
                    "objectiveIndex": 1
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.fisherman.postCatch.0",
                    "text": "Ha! You did it. You've got the basics of fishing down now."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.fisherman.postCatch.1",
                    "text": "But there's a big secret beneath these waters... and I still don't know what it is."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.fisherman.postCatch.2",
                    "text": "You should venture further onto the island to learn how things work around here."
                }
            ]
        }
    ],
    "lines": [
        {
            "speaker": "npc",
            "emotion": "happy",
            "textKey": "dialogue.npc.fisherman.greeting.0",
            "text": "Welcome to Anchor Hollow! Name's the Fisherman."
        },
        {
            "speaker": "player",
            "emotion": "surprise",
            "textKey": "dialogue.npc.fisherman.choice.prompt",
            "text": "What should I ask?",
            "options": [
                {
                    "id": "need_rod",
                    "textKey": "dialogue.npc.fisherman.choice.needRod",
                    "text": "Can I get a fishing rod?",
                    "branches": [
                        {
                            "checks": [
                                {
                                    "type": "hasItem",
                                    "itemId": "rickety_rod"
                                }
                            ],
                            "lines": [
                                {
                                    "speaker": "npc",
                                    "emotion": "happy",
                                    "textKey": "dialogue.npc.fisherman.needRod.hasRod.0",
                                    "text": "You've already got your rod. Equip it, then head to the water and cast your line."
                                }
                            ]
                        },
                        {
                            "lines": [
                                {
                                    "speaker": "npc",
                                    "emotion": "happy",
                                    "textKey": "dialogue.npc.fisherman.needRod.noRod.0",
                                    "text": "Aye, here you go — your first rod."
                                },
                                {
                                    "speaker": "npc",
                                    "emotion": "happy",
                                    "textKey": "dialogue.npc.fisherman.needRod.noRod.1",
                                    "text": "Equip your rod, find a good stretch of water, then cast and reel in your catch."
                                }
                            ],
                            "actions": [
                                {
                                    "type": "giveItem",
                                    "itemId": "rickety_rod",
                                    "amount": 1,
                                    "ifMissing": true
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "ask_basics",
                    "textKey": "dialogue.npc.fisherman.choice.basics",
                    "text": "How do I fish?",
                    "lines": [
                        {
                            "speaker": "npc",
                            "emotion": "happy",
                            "textKey": "dialogue.npc.fisherman.basics.0",
                            "text": "Equip your rod, find water, cast your line, and reel when you feel a bite."
                        },
                        {
                            "speaker": "npc",
                            "emotion": "happy",
                            "textKey": "dialogue.npc.fisherman.basics.1",
                            "text": "Once you've landed one, come back to me. You’ll know the basics... but there's a big secret I still don't know."
                        }
                    ]
                }
            ]
        }
    ]
}
