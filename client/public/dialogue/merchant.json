            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.intro.0",
                    "text": "Looking to buy something?"
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.antiDeath.intro.choice.prompt",
                    "text": "What do I even say?",
                    "options": [
                        {
                            "id": "uhhh_i_guess",
                            "textKey": "dialogue.npc.merchant.antiDeath.intro.choice.uhh",
                            "text": "Uhhh... I guess?",
                            "lines": [
                                {
                                    "speaker": "npc",
                                    "emotion": "surprise",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.1",
                                    "text": "Then let's start with money. You got any?"
                                },
                                {
                                    "speaker": "player",
                                    "emotion": "sad",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.2",
                                    "text": "No... not a single coin."
