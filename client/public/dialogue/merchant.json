                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.1",
                    "text": "For now. Soon I'll teach you how to turn yekfruits into a more nourishing meal."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.2",
                    "text": "Keep a few slotted and use them before panic takes over."
