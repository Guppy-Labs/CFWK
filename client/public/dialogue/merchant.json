            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.0",
                    "text": "Good haul. Those yekberries keep fighters standing."
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.player.0",
                    "text": "So this is just... survival food?"
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.1",
                    "text": "For now. Come back when you want the advanced method, and I'll show you how to refine food."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.return.2",
                    "text": "Keep a few slotted and use them before panic takes over. Then we'll upgrade your menu."
                }
            ]
        },
