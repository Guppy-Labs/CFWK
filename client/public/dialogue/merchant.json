            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.waresGalore.intro.0",
                    "text": "I heard through the grapevine that you have some money now... are the stories true?"
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.waresGalore.intro.player.0",
                    "text": "I guess..."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.waresGalore.intro.1",
                    "text": "Marvelous! A customer with coin is my favorite kind of miracle."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.waresGalore.intro.2",
                    "text": "Come see my wares any time. Soon I'll open the full stall for you."
                }
            ]
