            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.antiDeath.harvest.0",
                    "text": "Find a nearby Yekbush and gather some yekberries. Barely nourishing, but enough to keep you alive."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.antiDeath.harvest.1",
                    "text": "Come back once you've picked a bush and we'll call you battle-ready."
