                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.stomp.0",
                    "text": "Drop your yekberries on the ground and walk over them a few times."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.stomp.1",
                    "text": "No dainty steps. Mash them like they insulted your knife."
                }
            ]
        },
        {
