{
    "id": "merchant",
    "forks": [
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "merchant_side_brew",
                    "status": "active",
                    "objectiveIndex": 4
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.finish.0",
                    "text": "Now THAT is proper fuel. Smooth, sharp, and it actually keeps a blade-cat standing."
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.finish.player.0",
                    "text": "That healed way better than the raw berries."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.finish.1",
                    "text": "Exactly. Skill in the kitchen is skill in combat, just with fewer screams."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.finish.2",
                    "text": "Come back later and I'll teach you deadlier recipes. Anchor Hollow feeds those who experiment."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "merchant_side_brew",
                    "status": "active",
                    "objectiveIndex": 3
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.collect.0",
                    "text": "You made juice, now bottle it. Click the puddle and confirm the pour."
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.collect.1",
                    "text": "One jar in, one serving of Yek Juice out. Chemistry with consequences."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "merchant_side_brew",
                    "status": "active",
                    "objectiveIndex": 2
                }
            ],
            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.jar.0",
                    "text": "Perfect stomp-work. You wrung those berries into liquid."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.jar.1",
                    "text": "Hands can't hold a puddle, so use a jar. I'll spot you one for free."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.jar.2",
                    "text": "Next time, you pay. Glass doesn't grow on trees."
                }
            ],
            "actions": [
                {
                    "type": "giveItem",
                    "itemId": "jar",
                    "amount": 1,
                    "ifMissing": true
                }
            ]
        },
        {
            "checks": [
