                                {
                                    "speaker": "npc",
                                    "emotion": "surprise",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.3",
                                    "text": "How are you even surviving in Anchor Hollow?"
                                },
                                {
                                    "speaker": "player",
                                    "emotion": "sad",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.4",
                                    "text": "I'm new here. Still figuring things out."
                                },
                                {
                                    "speaker": "npc",
                                    "emotion": "happy",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.5",
                                    "text": "Alright, I'll help. Find a nearby Yekbush and grab some yekberries for a barely nourishing meal."
                                },
                                {
                                    "speaker": "npc",
                                    "emotion": "happy",
                                    "textKey": "dialogue.npc.merchant.antiDeath.intro.6",
                                    "text": "Bring them back to me when you've harvested one."
