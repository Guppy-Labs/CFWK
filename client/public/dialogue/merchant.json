            "lines": [
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.intro.0",
                    "text": "Back for lesson two? Good. Raw food keeps you alive, refined food wins fights."
                },
                {
                    "speaker": "player",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.intro.player.0",
                    "text": "So spending time on prep actually matters?"
                },
                {
                    "speaker": "npc",
                    "emotion": "happy",
                    "textKey": "dialogue.npc.merchant.sideBrew.intro.1",
                    "text": "Always. First trick: pressure extraction."
                },
                {
                    "speaker": "npc",
                    "emotion": "surprise",
                    "textKey": "dialogue.npc.merchant.sideBrew.intro.2",
                    "text": "Drop your berries, stomp them into liquid, then report back."
                }
            ]
        },
        {
            "checks": [
                {
                    "type": "questObjective",
                    "questId": "wares_galore",
